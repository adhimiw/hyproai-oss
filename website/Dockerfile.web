# Next.js image — context is website/web (see website/docker-compose.yml).
FROM node:26-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:26-alpine AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# Rewrites are baked at build time, so the sidecar URL must be present here —
# runtime env alone is too late for /api/sidecar/* (the route handler reads it
# at request time, the rewrite manifest does not).
ARG SIDECAR_URL=http://localhost:8787
ENV SIDECAR_URL=$SIDECAR_URL \
    NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:26-alpine AS run
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000
COPY --from=build /app ./
EXPOSE 3000
CMD ["npm", "start"]
